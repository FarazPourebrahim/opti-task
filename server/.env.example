# Copy to .env and fill in. Never commit the real .env.

# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgres://optitask:optitask@localhost:5432/optitask

# Auth (set in later phases)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Logging
LOG_LEVEL=info