# Copy to .env and fill in. Never commit the real .env.

# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgres://optitask:optitask@localhost:5432/optitask

# Auth (set in later phases)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Browser origins allowed to send credentialed requests (comma-separated).
# Required in production: a credentialed CORS response cannot use `*`, so an
# empty list means no browser client can reach this API. Bare origins only —
# no path, no trailing slash.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=info