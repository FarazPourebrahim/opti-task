{
  // The end-to-end suite runs in Node under Playwright, not in the app bundle,
  // so it is checked on its own: Node types, none of the app's globals.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["./**/*.ts", "../playwright.config.ts"],
  "exclude": [".results"]
}
