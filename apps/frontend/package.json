{
  "name": "optitask-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OptiTask frontend — React SPA client for the OptiTask GraphQL API",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts --check",
    "depth:check": "node scripts/check-query-depth.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "verify": "tsc --noEmit && eslint \"src/**/*.{ts,tsx}\" && node scripts/check-query-depth.mjs && vitest run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@apollo/client": "^4.2.12",
    "@averoui/react": "^2.2.1",
    "@averoui/tokens": "^2.2.1",
    "@contracts": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tanstack/react-virtual": "^3.14.13",
    "cmdk": "^1.1.1",
    "graphql": "^16.10.0",
    "graphql-ws": "^6.0.8",
    "i18next": "^26.4.2",
    "lucide-react": "^1.44.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.13",
    "react-router": "^7",
    "rxjs": "^7.8.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "happy-dom": "^20.14.3",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
